# Template only; never commit a real key.
# Terra live API: set CIMIS_APP_KEY explicitly in the server process environment.
# PowerShell: $env:CIMIS_APP_KEY = "<your CIMIS AppKey>"
# macOS/Linux: export CIMIS_APP_KEY="<your CIMIS AppKey>"
CIMIS_APP_KEY=

# Optional Twilio SMS. Disabled unless explicitly enabled. Never put these in VITE_*.
# Use process variables or an explicitly selected ignored file:
# TERRA_SMS_ENV_FILE=.terra-local/twilio.env
TERRA_SMS_ENABLED=false
TERRA_SMS_DEMO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Alternatively use an existing Twilio API key instead of the account Auth Token:
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_FROM_NUMBER=
TERRA_SMS_TO_NUMBER=
TERRA_SMS_DB_PATH=.terra-local/sms.sqlite3
TERRA_SMS_MAX_PER_DAY=10

# Optional for Nathan's separate native data/training pipeline:
# CHILLWATCH_DB_URL=postgresql+psycopg://chillwatch:chillwatch@localhost:5432/chillwatch
